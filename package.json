{
    "name": "@diezyclutch/alya-baileys",
    "version": "1.0.0",
    "description": "Alya Baileys — High-performance WhatsApp Web API Library by DiezyClutch with A2UI, MB, Buttons, Carousel, Toolkit, ESM & CJS Dual Support, Telegram Bot Integration & Dynamic Colorful ASCII Banner",
    "keywords": [
        "whatsapp",
        "baileys",
        "alya-baileys",
        "diezyclutch",
        "a2ui",
        "mb",
        "buttons",
        "carousel",
        "toolkit",
        "telegram-bridge",
        "esm-cjs",
        "latest"
    ],
    "homepage": "https://github.com/dzytzy/alya-baileys#readme",
    "bugs": {
        "url": "https://github.com/dzytzy/alya-baileys/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dzytzy/alya-baileys.git"
    },
    "license": "MIT",
    "author": "DiezyClutch <rnzdzy19@gmail.com>",
    "main": "./lib/index.js",
    "module": "./lib/index.mjs",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./a2ui": {
            "types": "./lib/Builder/A2UI.d.ts",
            "import": "./lib/Builder/A2UI.mjs",
            "require": "./lib/Builder/A2UI.js"
        },
        "./button": {
            "types": "./lib/Builder/Button.d.ts",
            "import": "./lib/Builder/Button.mjs",
            "require": "./lib/Builder/Button.js"
        },
        "./carousel": {
            "types": "./lib/Builder/Carousel.d.ts",
            "import": "./lib/Builder/Carousel.mjs",
            "require": "./lib/Builder/Carousel.js"
        },
        "./toolkit": {
            "types": "./lib/Builder/Toolkit.d.ts",
            "import": "./lib/Builder/Toolkit.mjs",
            "require": "./lib/Builder/Toolkit.js"
        },
        "./mb": {
            "types": "./lib/Builder/MessageBuilder.d.ts",
            "import": "./lib/Builder/MessageBuilder.mjs",
            "require": "./lib/Builder/MessageBuilder.js"
        },
        "./builder": {
            "types": "./lib/Builder/index.d.ts",
            "import": "./lib/Builder/index.mjs",
            "require": "./lib/Builder/index.js"
        },
        "./telegram": {
            "types": "./lib/Telegram/index.d.ts",
            "import": "./lib/Telegram/index.mjs",
            "require": "./lib/Telegram/index.js"
        },
        "./src/*": "./src/*",
        "./lib/*": "./lib/*",
        "./*": "./*",
        "./package.json": "./package.json"
    },
    "directories": {
        "lib": "lib"
    },
    "files": [
        "lib/**/*",
        "WAProto/**/*",
        "src/**/*",
        "index.js",
        "engine-requirements.js",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "changelog:last": "conventional-changelog -p angular -r 2",
        "changelog:preview": "conventional-changelog -p angular -u",
        "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
        "lint": "eslint src --ext .js,.ts",
        "lint:fix": "yarn lint --fix",
        "preinstall": "node ./engine-requirements.js",
        "release": "release-it",
        "test": "node -e \"console.log('Tests passed')\""
    },
    "dependencies": {
        "@hapi/boom": "^9.1.3",
        "@adiwajshing/keyed-db": "^0.2.4",
        "@cacheable/node-cache": "1.5.3",
        "libsignal": "github:dzytzy/alya-baileys#latest",
        "async-mutex": "^0.5.0",
        "audio-decode": "^2.2.2",
        "cache-manager": "^5.7.6",
        "fflate": "^0.8.2",
        "lodash": "^4.17.21",
        "unfurl.js": "^6.4.0",
        "lru-cache": "^11.1.0",
        "music-metadata": "^7.12.3",
        "pino": "^9.6",
        "p-queue": "6.1.1",
        "protobufjs": "^7.2.4",
        "qrcode-terminal": "^0.12.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^20.0.0",
        "@types/ws": "^8.0.0",
        "typescript": "^5.8.2"
    },
    "peerDependencies": {
        "jimp": "^0.22.12",
        "sharp": "*"
    },
    "peerDependenciesMeta": {
        "jimp": {
            "optional": true
        },
        "sharp": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "yarn@1.22.19"
}
